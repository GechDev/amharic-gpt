# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caching and testing
.pytest_cache/
.coverage
htmlcov/

# Environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Checkpoint archives (keep sample baseline checkpoint)
checkpoints/*.npz
!checkpoints/checkpoint.npz
!checkpoints/.gitkeep

# Outputs
outputs/*
!outputs/.gitkeep
!outputs/experiments.csv
!outputs/samples_best_model.txt
!outputs/corpus_report.md
!outputs/corpus_report.json
!outputs/tokenizer_comparison.md
!outputs/tokenizer_comparison.json

# Large raw datasets (keep gitkeep and sample)
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_amharic.txt
data/processed/*
!data/processed/.gitkeep
